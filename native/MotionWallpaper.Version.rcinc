#include <winver.h>

#define MOTION_FILE_VERSION 0,1,0,65535
#define MOTION_FILE_VERSION_TEXT "0.1.0.65535"
#define MOTION_PRODUCT_VERSION_TEXT "0.1.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MOTION_FILE_VERSION
 PRODUCTVERSION MOTION_FILE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "MotionWallpaper contributors"
            VALUE "FileDescription", MOTION_FILE_DESCRIPTION
            VALUE "FileVersion", MOTION_FILE_VERSION_TEXT
            VALUE "InternalName", MOTION_INTERNAL_NAME
            VALUE "LegalCopyright", "Copyright (c) 2026 MotionWallpaper contributors"
            VALUE "OriginalFilename", MOTION_ORIGINAL_FILENAME
            VALUE "ProductName", "MotionWallpaper"
            VALUE "ProductVersion", MOTION_PRODUCT_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
