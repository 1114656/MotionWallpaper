                                            <TextBlock x:Name="StorageQuotaCaption" Grid.Column="1" Style="{StaticResource QuietTextStyle}" />
                                        </Grid>
                                        <ProgressBar x:Name="StorageUsageBar" Minimum="0" Maximum="100" Value="0" Height="6" Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSoftBrush}" AutomationProperties.Name="性能副本已用容量占已保存上限的比例" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="24" Padding="0,4,0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="最多可回收" Style="{StaticResource QuietTextStyle}" FontSize="13" />
                                            <TextBlock x:Name="StorageReclaimableValue" Text="—" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="未完成任务" Style="{StaticResource QuietTextStyle}" FontSize="13" />
                                            <TextBlock x:Name="StorageQueueValue" Text="—" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="副本容量上限" FontSize="15" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <ComboBox x:Name="OptimizationQuota" SelectedIndex="2" Width="190" AutomationProperties.Name="优化版本磁盘配额">
                                                    <ComboBoxItem Content="最多 2 GB" Tag="2147483648" />
                                                    <ComboBoxItem Content="最多 5 GB" Tag="5368709120" />
                                                    <ComboBoxItem Content="最多 10 GB" Tag="10737418240" />
                                                    <ComboBoxItem Content="最多 20 GB" Tag="21474836480" />
                                                    <ComboBoxItem Content="不限制" Tag="0" />
                                                </ComboBox>
                                                <Button Content="保存并整理" Click="ApplyOptimizationQuota_Click" VerticalAlignment="Center" Padding="14,8" />
                                            </StackPanel>
                                            <TextBlock Text="超出上限时，优先整理较久未使用、可由源文件再生成的副本。" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="清理可回收副本" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock x:Name="OptimizationStorageText" Text="正在读取副本状态…" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="释放空间" Click="ReleaseOptimizationSpace_Click" VerticalAlignment="Center" Padding="14,8" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="StorageRightColumn" Grid.Column="2" Spacing="18">
                                <Border Style="{StaticResource CardStyle}" Padding="20">
                                    <StackPanel Spacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="媒体库位置" FontSize="17" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="壁纸文件保存在这里。" Style="{StaticResource QuietTextStyle}" FontSize="13" />
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" CornerRadius="10" Background="{StaticResource SurfaceMutedBrush}" BorderThickness="0" ToolTipService.ToolTip="查看并复制完整路径" AutomationProperties.Name="查看媒体库完整路径">
                                            <TextBlock x:Name="LibraryPath" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <StackPanel Width="380" Spacing="8">
                                                        <TextBlock Text="媒体库完整路径" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="LibraryPathFull" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Content="打开文件夹" Click="OpenLibrary_Click" Padding="14,8" />
                                            <Button Content="移动位置" Click="MoveLibrary_Click" Padding="14,8" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="20">
                                    <StackPanel Spacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE74E;" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="备份与恢复" FontSize="17" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="备份媒体库与设置，换电脑或迁移时可恢复。" Style="{StaticResource QuietTextStyle}" FontSize="13" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Content="创建备份" Click="BackupLibrary_Click" Padding="14,8" />
                                            <Button Content="恢复备份" Click="RestoreLibrary_Click" Padding="14,8" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" MaxWidth="500" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20,0,20,88" />
            </Grid>
        </Grid>
    </Grid>
</Window>
