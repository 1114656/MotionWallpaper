<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MotionWallpaper.MainWindow" Title="Motion">
<Grid x:Name="AppRoot" RequestedTheme="Light" Background="#F6F7FB">
<Grid.Resources>
            <SolidColorBrush x:Key="CanvasBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#F1F3F9" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F3F4F9" />
            <SolidColorBrush x:Key="AccentBrush" Color="#5267F8" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#E5E9FF" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#E5E7F0" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#737B91" />
            <Style x:Key="QuietTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>
            <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            </Style>
            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>
            <Style x:Key="SettingRowStyle" TargetType="Border">
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinHeight" Value="62" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
            <Style x:Key="SettingIconStyle" TargetType="FontIcon">
                <Setter Property="Width" Value="28" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Foreground" Value="#24272C" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Width" Value="190" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,0,0,10" />
            </Style>

    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ListViewItemCornerRadius">12</CornerRadius>
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#E2E6FF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D5DDFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C8D2FF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#304AC8" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#304AC8" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#304AC8" />
    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#5267F8" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
    <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="MinWidth" Value="54" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Grid.Resources>
<Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
<Grid x:Name="AppTitleBar" Margin="26,0,150,0">
    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" IsHitTestVisible="False">
        <Viewbox Width="30" Height="30" AutomationProperties.AccessibilityView="Raw">
            <Canvas Width="32" Height="32">
                <Path Data="M7.5,5.8 L19.5,3 C22.3,2.3 24.4,4 25,6.8 L27.3,18.5 C27.9,21.2 26.2,23.5 23.5,24.1 L11.4,26.9 C8.7,27.5 6.4,25.8 5.8,23.1 L3.1,11.6 C2.5,8.9 4.6,6.4 7.5,5.8 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#A4AEFF" Offset="0" />
                            <GradientStop Color="#7B88F5" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path Data="M13,8 H24.5 C28,8 30,10 30,13.5 V18 C30,20 29.2,21.3 27.5,23 L23,27.5 C21.3,29.2 20,30 18,30 H13 C9.7,30 8,28.3 8,25 V13 C8,9.7 9.7,8 13,8 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EEF1FF" Offset="0" />
                            <GradientStop Color="#A9B8FF" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path Data="M13,8 H24.5 C28,8 30,10 30,13.5 V17 C30,19.2 29.2,20.4 26.7,20.8 L23.5,21.3 C19.5,22 18.2,24.4 18,27 C17.9,29 16.4,30 14.5,30 H13 C9.7,30 8,28.3 8,25 V13 C8,9.7 9.7,8 13,8 Z">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                            <GradientStop Color="#6588FF" Offset="0" />
                            <GradientStop Color="#5267F8" Offset="0.55" />
                            <GradientStop Color="#4C51DF" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Canvas>
        </Viewbox>
        <TextBlock Text="Motion" FontFamily="Segoe Script" FontSize="20" FontWeight="Bold"
                   CharacterSpacing="-30" VerticalAlignment="Center" Margin="0,2,0,0">
            <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,0.4" EndPoint="1,0.6">
                    <GradientStop Color="#3266DA" Offset="0" />
                    <GradientStop Color="#5267F8" Offset="0.45" />
                    <GradientStop Color="#7950D1" Offset="1" />
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>
    </StackPanel>
</Grid>
<Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="176" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#F1F3F9" CornerRadius="18" Margin="10,0,0,10" Padding="10,12,10,12">
        <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <Button x:Name="WallpaperNavButton" Click="WallpaperNav_Click" Style="{StaticResource SidebarButtonStyle}" Height="42" AutomationProperties.Name="壁纸库">
        <Grid><Border x:Name="WallpaperNavIndicator" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" Margin="-7,4,0,4" CornerRadius="2" Background="{StaticResource AccentBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8B9;" FontSize="20" Width="24" /><TextBlock Text="壁纸库" FontSize="16" VerticalAlignment="Center" /></StackPanel></Grid>
    </Button>
                <Button x:Name="DisplaysNavButton" Click="DisplaysNav_Click" Style="{StaticResource SidebarButtonStyle}" Height="42" AutomationProperties.Name="屏幕">
        <Grid><Border x:Name="DisplaysNavIndicator" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" Margin="-7,4,0,4" CornerRadius="2" Background="{StaticResource AccentBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7F4;" FontSize="20" Width="24" /><TextBlock Text="屏幕" FontSize="16" VerticalAlignment="Center" /></StackPanel></Grid>
    </Button>
                <Button x:Name="VariantsNavButton" Click="Variants_Click" Style="{StaticResource SidebarButtonStyle}" Height="42" AutomationProperties.Name="任务">
        <Grid><Border x:Name="VariantsNavIndicator" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" Margin="-7,4,0,4" CornerRadius="2" Background="{StaticResource AccentBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE9D5;" FontSize="20" Width="24" /><TextBlock Text="任务" FontSize="16" VerticalAlignment="Center" /></StackPanel></Grid>
    </Button>
            </StackPanel>
            <Grid Grid.Row="1" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid BorderBrush="#DDE1F1" BorderThickness="0,1,0,0" Padding="6,10,0,0"><TextBlock Text="我的分组" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" /><Button x:Name="AddGroupButton" HorizontalAlignment="Right" Width="28" Height="28" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="新建分组">
                                                            <FontIcon Glyph="" FontSize="13" />
                                                            <Button.Flyout>
                                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                                    <StackPanel Width="250" Spacing="10">
                                                                        <TextBlock Text="新建壁纸分组" FontSize="16" FontWeight="SemiBold" />
                                                                        <TextBox x:Name="NewGroupName" PlaceholderText="例如：自然风景" MaxLength="80" />
                                                                        <Button Content="创建分组" Click="CreateGroup_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button></Grid>
                <Grid Grid.Row="1" VerticalAlignment="Top"><ListView FontSize="15" x:Name="GroupPicker" SelectionChanged="GroupPicker_SelectionChanged" ContextRequested="GroupPicker_ContextRequested" ContextCanceled="GroupPicker_ContextCanceled" DragItemsStarting="GroupPicker_DragItemsStarting" DragItemsCompleted="GroupPicker_DragItemsCompleted" SelectionMode="Single" CanDragItems="True" CanReorderItems="True" AllowDrop="True" IsSwipeEnabled="False" HorizontalContentAlignment="Stretch" MaxHeight="400">
                                                        <FlyoutBase.AttachedFlyout>
                                                            <MenuFlyout x:Name="GroupContextMenu">
                                                                <MenuFlyoutItem Text="重命名分组" Click="RenameGroup_Click" />
                                                                <MenuFlyoutItem Text="新建分组" Click="OpenNewGroup_Click" />
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem x:Name="GroupMoveUpItem" Text="上移" Click="MoveGroupUp_Click" />
                                                                <MenuFlyoutItem x:Name="GroupMoveDownItem" Text="下移" Click="MoveGroupDown_Click" />
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem Text="删除分组" Click="DeleteGroup_Click" Foreground="#C42B1C" />
                                                            </MenuFlyout>
                                                        </FlyoutBase.AttachedFlyout>
                                                        <ListView.ItemContainerStyle>
                                                            <Style TargetType="ListViewItem">
                                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                <Setter Property="Padding" Value="13,9" />
                                                                <Setter Property="Margin" Value="0,2" />
                                                                <Setter Property="CornerRadius" Value="12" />
                                                            </Style>
                                                        </ListView.ItemContainerStyle>
                                                    </ListView></Grid>
            </Grid>
            <StackPanel Grid.Row="2" Spacing="4">
                <Button x:Name="StorageNavButton" Click="StorageNav_Click" Style="{StaticResource SidebarButtonStyle}" Height="42" AutomationProperties.Name="存储">
        <Grid><Border x:Name="StorageNavIndicator" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" Margin="-7,4,0,4" CornerRadius="2" Background="{StaticResource AccentBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xEDA2;" FontSize="20" Width="24" /><TextBlock Text="存储" FontSize="16" VerticalAlignment="Center" /></StackPanel></Grid>
    </Button>
                <Button x:Name="SettingsNavButton" Click="SystemSettings_Click" Style="{StaticResource SidebarButtonStyle}" Height="42" AutomationProperties.Name="设置">
        <Grid><Border x:Name="SettingsNavIndicator" Visibility="Collapsed" Width="3" HorizontalAlignment="Left" Margin="-7,4,0,4" CornerRadius="2" Background="{StaticResource AccentBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE713;" FontSize="20" Width="24" /><TextBlock Text="设置" FontSize="16" VerticalAlignment="Center" /></StackPanel></Grid>
    </Button>
            </StackPanel>
        </Grid>
    </Border>
    <Grid Grid.Column="1">
        <UserControl x:Name="WallpaperPage">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogColumn" Width="*" /><ColumnDefinition x:Name="InspectorColumn" Width="330" /></Grid.ColumnDefinitions>
                <Grid x:Name="GalleryArea" Padding="20,20,18,16" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="GalleryHeading" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock x:Name="GroupTitle" Text="我的壁纸" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="MediaCount" Text="让桌面动起来" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"><ToggleButton x:Name="AllMediaFilter" Content="全部" Tag="0" IsChecked="True" Style="{StaticResource FilterChipStyle}" Click="MediaKind_Click" /><ToggleButton x:Name="VideoMediaFilter" Content="视频" Tag="1" Style="{StaticResource FilterChipStyle}" Click="MediaKind_Click" /><ToggleButton x:Name="ImageMediaFilter" Content="图片" Tag="2" Style="{StaticResource FilterChipStyle}" Click="MediaKind_Click" /></StackPanel>
                    </Grid>
                    <Grid x:Name="GalleryToolbar" Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="MediaSearchBox" PlaceholderText="搜索壁纸" TextChanged="MediaSearch_Changed" AutomationProperties.Name="搜索壁纸" Height="38" FontSize="13" CornerRadius="10" Padding="34,7,10,7" VerticalContentAlignment="Center" BorderThickness="1" Background="#FFFFFF">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#E0E4EF" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#BBC4DF" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5267F8" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                            <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                        <Button Grid.Column="1" Width="38" Height="38" Padding="0" CornerRadius="10" BorderBrush="#E0E4EF" Background="#FFFFFF" AutomationProperties.Name="筛选壁纸" ToolTipService.ToolTip="筛选壁纸"><FontIcon Glyph="&#xE71C;" FontSize="15" /><Button.Flyout><Flyout>
                                                <StackPanel Width="240" Spacing="10">
                                                    <TextBlock Text="筛选壁纸" FontWeight="SemiBold" />
                                                    <TextBox x:Name="MediaTagFilter" PlaceholderText="按标签筛选（可多项）" TextChanged="MediaSearch_Changed" />
                                                    <ComboBox x:Name="MediaKindFilter" SelectedIndex="0" SelectionChanged="MediaFilter_Changed" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="全部类型" Tag="" />
                                                        <ComboBoxItem Content="视频" Tag="video" />
                                                        <ComboBoxItem Content="图片" Tag="image" />
                                                    </ComboBox>
                                                    <ToggleButton x:Name="FavoritesOnlyButton" Content="收藏" Click="MediaFilter_Click" ToolTipService.ToolTip="只显示收藏" />
                                                    <ToggleButton x:Name="BatchModeButton" Content="批量管理" Click="BatchMode_Click" />
                                                    <Button Content="修复重复项" Click="RepairDuplicates_Click" />
                                                </StackPanel>
                                            </Flyout></Button.Flyout></Button>
                        <ComboBox x:Name="SortPicker" Grid.Column="2" SelectedIndex="0" SelectionChanged="Sort_Changed" Width="126" Height="38" FontSize="13" CornerRadius="10" Background="#FFFFFF" BorderBrush="#E0E4EF" AutomationProperties.Name="壁纸排序">
                                                        <ComboBoxItem Content="按名称" Tag="name" />
                                                        <ComboBoxItem Content="最近导入" Tag="newest" />
                                                        <ComboBoxItem Content="按文件大小" Tag="size" />
                                                        <ComboBoxItem Content="视频优先" Tag="kind" />
                        </ComboBox>
                        <Button Grid.Column="3" Height="38" Padding="13,0" CornerRadius="10" Background="#FFFFFF" BorderBrush="#E0E4EF" AutomationProperties.Name="导入壁纸">
                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock Text="导入" FontSize="13" /></StackPanel>
                            <Button.Flyout><Flyout>
                                <StackPanel Width="220" Spacing="8">
                                    <Button x:Name="ImportImageButton" Content="导入图片" Click="ImportImage_Click" HorizontalAlignment="Stretch" Height="42" />
                                    <Button x:Name="ImportVideoButton" Content="导入视频" Click="ImportVideo_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="42" />
                                </StackPanel>
                            </Flyout></Button.Flyout>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="2">
                        <GridView x:Name="MediaList" SelectionChanged="Media_SelectionChanged" SelectionMode="Single" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsItemClickEnabled="False">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="256" /></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="18" /></Style></GridView.ItemContainerStyle>
                        </GridView>
                        <StackPanel x:Name="MediaEmptyState" Visibility="Collapsed" VerticalAlignment="Center" Spacing="12" Margin="8"><FontIcon Glyph="&#xE8B9;" FontSize="32" Opacity="0.4" /><TextBlock Text="没有符合条件的壁纸" TextAlignment="Center" FontWeight="SemiBold" /><TextBlock Text="导入图片或视频，或清除筛选条件。" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource QuietTextStyle}" /></StackPanel>
                    </Grid>

                </Grid>
                <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="24" Margin="0,0,12,12" Padding="20" BorderBrush="#EDF0F6" BorderThickness="1">
                    <Grid RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <Border x:Name="DraftPreviewFrame" Height="174" CornerRadius="18" Background="#EFF1F7"><Grid><Image x:Name="DraftPreview" Stretch="UniformToFill" Visibility="Collapsed" /><StackPanel x:Name="DraftPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"><FontIcon Glyph="&#xE8B9;" FontSize="32" Opacity="0.3" /><TextBlock Text="选择一张壁纸" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" /></StackPanel></Grid></Border>
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="DraftTitle" Text="选择一张壁纸" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><Button Grid.Column="1" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="管理所选壁纸"><FontIcon Glyph="&#xE712;" FontSize="16" /><Button.Flyout><Flyout Placement="BottomEdgeAlignedRight">
                                                    <StackPanel Width="180" Spacing="4">
                                                        <Button x:Name="RenameMediaButton" Content="重命名" Click="RenameMedia_Click" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                                        <Button x:Name="MoveMediaButton" Content="移动分组" Click="MoveMedia_Click" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                                        <Button x:Name="FavoriteMediaButton" Content="收藏 / 取消收藏" Click="ToggleFavorite_Click" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                                        <Button x:Name="TagMediaButton" Content="编辑标签" Click="EditTags_Click" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                                        <Button x:Name="DeleteMediaButton" Content="删除壁纸本体" Click="DeleteMedia_Click" IsEnabled="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Foreground="#C42B1C" />
                                                    </StackPanel>
                                                </Flyout></Button.Flyout></Button></Grid>
                                    <TextBlock x:Name="DraftDetailsText" Text="选择后可预览和应用" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="DraftState" Text="未选择" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                                <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0"><StackPanel Spacing="10">
                                    <Grid><TextBlock Text="应用到" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="识别屏幕" Click="IdentifyDisplays_Click" HorizontalAlignment="Right" FontSize="13" Padding="0,4" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" /></Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="DisplayTargetCards" Orientation="Horizontal" Spacing="8" /></ScrollViewer>
                                    <ToggleButton x:Name="AllDisplaysButton" Content="全部显示器" Click="AllDisplays_Click" FontSize="13" HorizontalAlignment="Right" HorizontalContentAlignment="Center" CornerRadius="10" />
                                    <TextBlock x:Name="TargetAssignmentText" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel></Border>
                                <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,15,0,0"><StackPanel Spacing="10">
                                    <TextBlock Text="画质（全局）" FontWeight="SemiBold" FontSize="15" />
                                    <Grid Background="#F2F3F8" CornerRadius="12" Padding="3" ColumnSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ToggleButton x:Name="OriginalQuality" Content="原画" Tag="original" Click="Quality_Click" Height="34" CornerRadius="9" HorizontalAlignment="Stretch" BorderThickness="0" /><ToggleButton Grid.Column="1" x:Name="BalancedQuality" Content="平衡" Tag="balanced" Click="Quality_Click" Height="34" CornerRadius="9" HorizontalAlignment="Stretch" BorderThickness="0" /><ToggleButton Grid.Column="2" x:Name="PowerSaverQuality" Content="节能" Tag="power-saver" Click="Quality_Click" Height="34" CornerRadius="9" HorizontalAlignment="Stretch" BorderThickness="0" /></Grid>
                                    <TextBlock x:Name="QualityHint" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                </StackPanel></Border>
                                <Border x:Name="ImportPanel" Style="{StaticResource CardStyle}" Padding="15" Visibility="Collapsed">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="8">
                                                <Grid>
                                                    <TextBlock x:Name="ImportStatusText" Text="正在导入…" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="ImportPercentText" Text="0%" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Grid>
                                                <ProgressBar x:Name="ImportProgress" Minimum="0" Maximum="100" Value="0" />
                                                <TextBlock Text="保持源文件原始字节；导入在后台执行。" Style="{StaticResource QuietTextStyle}" />
                                            </StackPanel>
                                            <Button x:Name="CancelImportButton" Grid.Column="1" Content="取消" Click="CancelImport_Click" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                <ComboBox x:Name="DisplayTargetPicker" Visibility="Collapsed" SelectionChanged="DisplayTargetPicker_Changed" />
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel Spacing="9">
